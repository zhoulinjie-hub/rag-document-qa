# DashScope：真实值只写入本地 .env 或部署平台的密钥管理。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
CHAT_MODEL=qwen-plus
EMBEDDING_BATCH_SIZE=10

# RAG 与日志。
MAX_PDF_BYTES=10485760
RAG_MIN_SCORE=0.25
LOG_LEVEL=INFO

# 面试演示访问控制。公开或容器运行时必须替换访问码占位符。
DEMO_ACCESS_TOKEN=replace-with-at-least-16-random-characters
DEMO_SESSION_TTL_MINUTES=240
DEMO_REQUESTS_PER_MINUTE=60
DEMO_UPLOADS_PER_HOUR=5
DEMO_ASKS_PER_MINUTE=20
DEMO_LOGINS_PER_10_MINUTES=10

# Dockerfile 启动命令读取；本地 uvicorn CLI 可自行指定端口。
PORT=8000
